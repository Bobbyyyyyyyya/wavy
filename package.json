{
  "name": "wavy",
  "version": "1.0.3",
  "description": "Convert audio files to waveform videos",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^24.0.0"
  },
  "allowScripts": {
    "electron@28.3.3": true
  },
  "build": {
    "appId": "com.wavy.app",
    "productName": "Wavy",
    "afterPack": "./scripts/after-pack.js",
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "assets/icon.icns",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}